#!/sbin/sh
#################################################################################
# This is a generic update-binary for installing Magisk modules in recovery
# or via fastbootd/ADB sideload. Do NOT modify anything here unless you know
# what you're doing.
#################################################################################
umask 022
OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || {
  echo "! Magisk is not installed"
  exit 1
}

. /data/adb/magisk/util_functions.sh
install_module
exit 0
